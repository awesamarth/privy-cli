{
  "name": "@awesamarth/privy-cli",
  "version": "0.1.2",
  "private": false,
  "description": "Manage your Privy account and apps from your agent or terminal. Inspired by Cloudflare's cf CLI (Unofficial)",
  "keywords": [
    "privy",
    "privy-io",
    "cli",
    "privy-dashboard",
    "dashboard",
    "embedded-wallets",
    "web3-auth",
    "wallet-policies",
    "ai-agent",
    "claude-code",
    "codex",
    "cursor",
    "devtools",
    "webhooks",
    "automation",
    "cloudflare",
    "cf",
    "privy-wallet"
  ],
  "license": "MIT",
  "author": "Samarth Saxena",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awesamarth/privy-cli.git"
  },
  "homepage": "https://privy-cli.awesamarth.dev",
  "bugs": {
    "url": "https://github.com/awesamarth/privy-cli/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "bin": {
    "privy": "./dist/cli.js"
  },
  "files": ["dist", "docs/user", "README.md"],
  "scripts": {
    "dev": "bun src/cli.ts",
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test && bun run build",
    "smoke:package": "node scripts/package-smoke.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.2",
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "22",
    "typescript": "^5.9.3"
  }
}
